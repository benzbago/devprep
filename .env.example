# Optional Phase 2 account features. Public demo routes work without these values.
# Obtain local values from `npx supabase status`; never commit `.env.local`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put the service-role key in a VITE_ variable. It is used only by the
# local authenticated Playwright test process, not by browser application code.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 grading Function values. SUPABASE_SECRET_KEY is server-only and must
# never be prefixed with VITE_. Local tests may use the legacy service-role key
# above as the server secret. Hosted values remain unconfigured until deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
